{
  "name": "web-analyzer-server",
  "version": "0.1.0",
  "description": "Website Analyzer API — given a URL, return a structured profile of the site.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx src/analyzer/crawl.test.ts",
    "test:pipeline": "tsx tests/pipeline.integration.test.ts && tsx tests/prototypes.generalization.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "tsx validation/run.ts",
    "worksheet": "tsx validation/buildWorksheet.ts",
    "score": "tsx validation/score.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.5",
    "crawlee": "^3.18.1",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
