# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# env / secrets
.env
.env.*
!.env.example

# legacy website-build-tool code, kept locally for reference only
reference/

# validation runs against real sites (names/bios scraped live — never commit)
server/validation/out/

# Crawlee's ephemeral request-queue/dataset storage
server/.crawlee-storage/

# local AI-tool skill/config files (installed per-machine by whatever agent
# tool is in use — not application code, ~2.5MB of skill docs/scripts that
# don't belong in version control)
.agents/
.claude/
skills-lock.json

# logs / os
*.log
.DS_Store
